    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
